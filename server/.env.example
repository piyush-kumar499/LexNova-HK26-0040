# ============================================================
# SS-01 server — environment template
# Copy to .env and fill in real values. NEVER commit real keys.
# ============================================================

PORT=8080
NODE_ENV=development

# --- Supabase (primary database) ---
# If SUPABASE_URL / SUPABASE_SERVICE_ROLE_KEY are empty in development,
# the server runs with an in-memory database (data lost on restart) and
# logs a loud warning. In production these are required.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_ANON_KEY=

# --- Vapi (AI voice calls) ---
# If VAPI_PRIVATE_KEY is empty, outbound calls use the MOCK provider.
# The mock never places a real call and says so in the logs.
VAPI_PRIVATE_KEY=
VAPI_PUBLIC_KEY=
VAPI_PHONE_NUMBER_ID=
VAPI_ASSISTANT_ID=
VAPI_WEBHOOK_SECRET=

# --- Public exposure (ngrok) ---
# Free ngrok URLs change on every restart. Update this and the Vapi
# dashboard webhook URL (NGROK_URL/vapi/webhook) after each restart.
NGROK_URL=

LOG_LEVEL=info

# --- Rate limiting ---
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=30

# --- Nearby device discovery ---
NEARBY_RADIUS_METERS=2000
NEARBY_MAX_RESULTS=50

# --- SOS escalation ---
SOS_ESCALATION_TIMEOUT_SECONDS=60
SOS_MAX_ESCALATION_LEVEL=3

# --- Development-only mock behavior (ignored when Vapi keys are present) ---
# answered | no-answer | silent
MOCK_VAPI_OUTCOME=answered
